APP_ENV=development

GRPC_PORT=50051

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=users
DB_SSLMODE=disable

GOOGLE_CLIENT_ID=
# должен совпадать с JWT_SECRET в gateway-be; срок cookie gateway берёт из exp токена
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
# должен совпадать со сроком cookie refresh_token в gateway-be (30 дней)
REFRESH_TOKEN_TTL=720h
